APP_ENV=local

# web
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://repotale:repotale@db:5432/repotale

# better-auth session encryption - generate with `openssl rand -base64 33`
AUTH_SECRET=

# github oauth app (dev app, separate from prod)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# google oauth app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# gitlab oauth app
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# apple "sign in with apple" (service id + generated client secret)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# llm - user brings their own provider/key
LLM_PROVIDER=anthropic
LLM_API_KEY=

# background jobs
TRIGGER_API_KEY=
