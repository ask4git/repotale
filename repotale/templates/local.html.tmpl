<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.RepoID}} — repotale</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; max-width: 640px; margin: 48px auto; padding: 0 24px; color: #1a1a1a; line-height: 1.6; }
  .repo { color: #666; font-size: 14px; margin-bottom: 24px; }
  h1 { font-size: 20px; margin: 0 0 32px; }
  .post { border: 1px solid #e5e5e5; border-radius: 10px; padding: 20px; margin-bottom: 16px; }
  .meta { font-size: 12px; color: #888; margin-bottom: 8px; }
  .tag { display: inline-block; border-radius: 999px; padding: 2px 10px; margin-right: 6px; font-size: 11px; }
  .tag-high { background: #fee2e2; color: #b91c1c; font-weight: 600; }
  .tag-mid { background: #eef2ff; color: #4338ca; }
  .tag-low { background: #f0f0f0; color: #888; }
  .title { font-size: 16px; font-weight: 600; margin: 0 0 8px; }
  .excerpt { font-size: 14px; color: #333; margin: 0; white-space: pre-line; }
  .sha { font-size: 12px; color: #999; margin-top: 12px; }
  .sha a { color: inherit; text-decoration: underline; text-decoration-color: #ccc; }
  .empty { color: #888; text-align: center; padding: 48px 0; }
  @media (prefers-color-scheme: dark) {
    body { background: #111; color: #eee; }
    .post { border-color: #333; }
    .tag-high { background: #4c1d1d; color: #fca5a5; }
    .tag-mid { background: #1e1b4b; color: #a5b4fc; }
    .tag-low { background: #222; color: #999; }
    .excerpt { color: #ccc; }
  }
</style>
</head>
<body>
  <p class="repo">{{.RepoID}}</p>
  <h1>{{.Heading}}</h1>
  {{$commitLabel := .CommitLabel}}
  {{$sessionLabel := .SessionLabel}}
  {{if .Posts}}
    {{range .Posts}}
    <div class="post">
      <div class="meta">
        <time>{{.PublishedAt}}</time>
        {{range .Tags}}<span class="tag {{tagClass .}}">{{.}}</span>{{end}}
      </div>
      <p class="title">{{.Title}}</p>
      <p class="excerpt">{{.Excerpt}}</p>
      <p class="sha">{{if .RepoURL}}<a href="{{.RepoURL}}/commit/{{.CommitSHA}}" target="_blank" rel="noreferrer">{{$commitLabel}} {{slice .CommitSHA 0 7}}</a>{{else}}{{$commitLabel}} {{slice .CommitSHA 0 7}}{{end}}{{if .SessionID}} · {{$sessionLabel}} {{.SessionID}}{{end}}</p>
    </div>
    {{end}}
  {{else}}
    <p class="empty">{{.Empty}}</p>
  {{end}}
</body>
</html>
